# Copy to backend/.env and adjust. backend/.env is not committed.
# Default (used when DATABASE_URL is not set): local SQL Server LocalDB, Windows login.
DATABASE_URL=mssql+mssqlpython://@(localdb)\MSSQLLocalDB/renewaldesk?Trusted_Connection=yes&Encrypt=no

# Another SQL Server with a SQL login:
# DATABASE_URL=mssql+mssqlpython://USER:PASSWORD@SERVER/renewaldesk?Encrypt=yes&TrustServerCertificate=yes
